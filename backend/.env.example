# PulseNet-GIS Email Configuration
# Copy this file to .env and fill in your credentials.
# The server reads these environment variables at startup.

# Gmail SMTP (recommended)
# 1. Enable 2-Factor Authentication on your Gmail account
# 2. Go to: Google Account > Security > App Passwords
# 3. Generate an App Password for "Mail"
# 4. Paste it below

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=shindesatyajit4747@gmail.com
SMTP_PASS=kpptiqtrbuljlszc

# This is where admin notification emails are sent
ADMIN_EMAIL=shindesatyajit4747@gmail.com

# ── How to run with env vars (Windows PowerShell) ──────────────────────────────
# $env:SMTP_USER="your@gmail.com"; $env:SMTP_PASS="xxxx xxxx xxxx xxxx"; $env:ADMIN_EMAIL="admin@yourorg.in"; uvicorn main:app --reload --port 8000
